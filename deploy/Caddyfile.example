# Caddy 反代模板：setup-server.sh / enable-domain.sh 会把 YOUR-DOMAIN 替换成你的域名
YOUR-DOMAIN {
	encode gzip

	# 前端静态文件根目录（SPA）
	root * /opt/myblog/apps/web/dist

	# API 与上传资源反向代理到 Node 后端
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /uploads/* {
		reverse_proxy 127.0.0.1:3000
	}

	# 带内容哈希的构建产物：可以放心长期缓存
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 其余路径（index.html 与 SPA 路由）：每次都回源校验。
	# 否则浏览器会拿旧的 index.html 去加载旧 chunk —— 表现就是
	# 「新功能/新页面点了没反应、被跳回首页」，强刷一次才正常。
	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
