// 拾页书阁 · Prisma Schema
// SQLite 适配说明（见 README）：
//  - 不支持 enum：状态字段用 String 存储，取值由 @myblog/shared 常量约束
//  - 不支持 Json：复杂结构字段序列化为 String（Phase 4 的 citations 等）
//  - 不使用 @db.Text（非 SQLite 类型注解）

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  nickname  String
  avatar    String?
  bio       String?
  createdAt DateTime @default(now())
}

model Article {
  id              Int      @id @default(autoincrement())
  slug            String   @unique
  title           String
  summary         String?
  cover           String?
  contentMarkdown String
  wordCount       Int      @default(0)
  readingMinutes  Int      @default(0)
  status          String   @default("PUBLISHED") // DRAFT / PUBLISHED / ARCHIVED
  source          String   @default("MANUAL")    // MANUAL / UPLOAD
  private         Boolean  @default(false)       // 私密：不进入 AI 知识库（AI 不可读）
  fileId          Int?     @unique               // 关联上传文件，可溯源
  categoryId      Int?
  category        Category?     @relation(fields: [categoryId], references: [id])
  tags            ArticleTag[]
  chapters        Chapter[]
  stats           ArticleStats?
  chunks          KnowledgeChunk[]
  questionsJson   String   @default("[]") // AI 整理的"可以问这篇文章的问题"
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  annotations     Annotation[]

  @@index([status, publishedAt])
}

// 句子书注：读者可对文章中的某句话写注释（外部书写，公开可见）
model Annotation {
  id           Int      @id @default(autoincrement())
  articleId    Int
  article      Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  chapterIndex Int
  quoteText    String // 被注释的句子（原文片段）
  note         String // 注释内容
  author       String? // 署名（可选，访客填写）
  ipHash       String // 作者 IP 的 SHA-256（用于限流，不存原始 IP）
  createdAt    DateTime @default(now())

  @@index([articleId, chapterIndex])
}

// 知识检索分块（Phase 4：知识问答的本地语料，无外键级联由 article 关系保证）
model KnowledgeChunk {
  id         Int     @id @default(autoincrement())
  articleId  Int
  article    Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String

  @@index([articleId])
}

model Chapter {
  id        Int     @id @default(autoincrement())
  articleId Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  index     Int
  title     String
  contentMd String
  wordCount Int

  @@unique([articleId, index])
}

model Tag {
  id       Int          @id @default(autoincrement())
  name     String       @unique
  color    String?
  articles ArticleTag[]
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  articles    Article[]
}

model ArticleTag {
  articleId Int
  tagId     Int
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model ArticleStats {
  id               Int      @id @default(autoincrement())
  articleId        Int      @unique
  article          Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  viewCount        Int      @default(0)
  readCount        Int      @default(0)
  totalReadSeconds Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model UploadFile {
  id         Int      @id @default(autoincrement())
  filename   String
  storedPath String
  mime       String
  size       Int
  sha256     String   @unique
  kind       String // MD / TXT / PDF / DOCX / IMAGE
  status     String   @default("PENDING") // PENDING / PARSED / INDEXED / FAILED
  articleId  Int?
  error      String?
  createdAt  DateTime @default(now())
}

// 文章版本快照：每次更新/删除前自动保存，支持 Ctrl+Z 撤销（更新回滚 / 删除重建）
// 无外键关联：文章删除后版本仍保留，供"撤销删除"重建
model ArticleRevision {
  id              Int      @id @default(autoincrement())
  articleId       Int
  slug            String
  title           String
  summary         String?
  category        String?
  cover           String?
  tagsJson        String   @default("[]")
  status          String
  private         Boolean  @default(false)
  contentMarkdown String
  wordCount       Int
  readingMinutes  Int
  createdAt       DateTime @default(now())

  @@index([articleId, createdAt])
}

// 知识问答会话（历史记录）
model ChatSession {
  id        Int           @id @default(autoincrement())
  title     String
  createdAt DateTime      @default(now())
  messages  ChatMessage[]
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  sessionId Int
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // USER / ASSISTANT
  content   String
  citations String? // JSON 字符串：引用来源列表
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// LLM 用量统计（按天一行：token 消耗 / 调用次数 / 花费）
model LlmUsage {
  date    String @id // YYYY-MM-DD
  tokens  Int    @default(0)
  calls   Int    @default(0)
  costUsd Float  @default(0)
}

model ReadingProgress {
  id           Int      @id @default(autoincrement())
  userId       Int?
  articleId    Int
  chapterIndex Int
  scrollPct    Float    @default(0)
  updatedAt    DateTime @updatedAt

  @@unique([userId, articleId])
}

// Phase 4（LLM/RAG）追加：KnowledgeChunk / ChatSession / ChatMessage
// 向量表：sqlite-vec 虚拟表，id 对齐 KnowledgeChunk.id
