    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.10",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
